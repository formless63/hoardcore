{
  "name": "hoardcore",
  "private": true,
  "version": "0.0.0",
  "description": "Self-hosted inventory research for people who keep finding reasons to buy more inventory.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc6 --noEmit",
    "check": "pnpm test && pnpm build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts src/features/sources/sources.integration.test.ts",
    "typecheck": "tsc6 --noEmit",
    "docker:build": "docker build --tag hoardcore:local .",
    "docker:smoke": "docker run --rm --entrypoint node hoardcore:local -e \"require('sharp')({ create: { width: 1, height: 1, channels: 4, background: 'transparent' } }).png().toBuffer().then(() => console.log('sharp OK'))\""
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@fontsource-variable/alan-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.54",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.5",
    "cheerio": "^1.2.0",
    "croner": "10.0.1",
    "cronstrue": "3.27.0",
    "drizzle-orm": "^0.45.2",
    "graphile-worker": "^0.18.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robots-parser": "3.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "nitro": "^3.0.260311-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linuxmusl-x64": "1.3.3",
    "@img/sharp-linuxmusl-x64": "0.35.4"
  }
}
