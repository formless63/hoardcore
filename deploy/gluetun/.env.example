# Copy to a private .env on the deployment host. Fill every blank value.
# Actual stack-file directory on the Docker host, not an arbitrary data folder.
# With Hawser's default STACKS_DIR and a stack named gluetun:
STACK_DIR=/data/stacks/gluetun
GATEWAY_NETWORK=your-existing-gateway-network
TZ=Etc/UTC

# From PrivateKey in a Proton-generated WireGuard configuration.
PROTON_KEY=
SERVER_COUNTRIES=United States

VPN_PROXY_USER=vpnclient
# Generate with: openssl rand -hex 32
VPN_PROXY_PASS=
# Generate with: docker run --rm qmcgaw/gluetun:v3.41.3 genkey
GLUETUN_API_KEY=
# Generate with: openssl rand -hex 32
# Keep stable: changing this key affects sessions and encrypted profile secrets.
COMPANION_SECRET_KEY=

VPN_PROXY_PORT=8888
VPN_CONTROL_PORT=8000
FIREWALL_OUTBOUND_SUBNETS=

# Optional tested image/tag/digest overrides. Companion is explicitly beta upstream.
# GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.3
# COMPANION_IMAGE=ghcr.io/aerya/gluetun-companion@sha256:...
# SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy@sha256:...
