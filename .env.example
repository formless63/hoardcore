# Application
APP_URL=http://localhost:3000
# Host port used by Docker Compose. It is bound to loopback only.
APP_PORT=3000

# PostgreSQL for host-run CLI and development commands.
# Compose uses POSTGRES_PASSWORD for both the database and application containers.
# If you change it, update the password in DATABASE_URL for host-run migrations too.
# Use a URL-safe random value because Compose embeds it in a PostgreSQL URL.
POSTGRES_PASSWORD=hoardcore
DATABASE_URL=postgresql://hoardcore:hoardcore@127.0.0.1:5432/hoardcore

# Reserved for the planned Better Auth / OIDC foundation.
AUTH_SECRET=replace-with-a-long-random-secret
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
