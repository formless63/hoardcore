# Application
APP_URL=http://localhost:3000
# Host port used by Docker Compose. It is bound to loopback only.
APP_PORT=3000

# Optional when using compose.gateway.yaml with a containerized gateway.
# APP_CONTAINER_NAME=hoardcore-app
# GATEWAY_NETWORK=your-existing-gateway-network

# PostgreSQL for host-run CLI and development commands.
# Compose uses POSTGRES_PASSWORD for both the database and application containers.
# If you change it, update the password in DATABASE_URL for host-run migrations too.
# Use a URL-safe random value because Compose embeds it in a PostgreSQL URL.
POSTGRES_PASSWORD=hoardcore
DATABASE_URL=postgresql://hoardcore:hoardcore@127.0.0.1:5432/hoardcore

# Better Auth. Use at least 32 random characters; no Hoardcore-hosted identity service is required.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Optional provider-neutral OIDC (set all three values together, or leave all blank).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional display name and same-origin image path for the OIDC login button.
OIDC_PROVIDER_NAME=
OIDC_PROVIDER_ICON_URL=

# Optional fallback sign-in for existing OIDC-created users only. Set all five
# SMTP values together; the app requires TLS (implicit TLS on 465, STARTTLS otherwise).
# Never commit real SMTP credentials. Leave blank to hide email sign-in.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional true/false; defaults to true for port 465, false otherwise.
SMTP_SECURE=

# Optional ntfy bearer token used for protected topics. Set both values together.
# The token is sent only when a user's ntfy endpoint exactly matches this HTTPS origin.
# Never commit the real token; configure each app host's private .env independently.
NTFY_AUTH_ORIGIN=
NTFY_ACCESS_TOKEN=

# Optional server-side photo acquisition. Leave false on development hosts and
# enable only on an operator-approved collection host. When enabled, catalog
# runs queue bounded, paced photo batches automatically; manual batches remain available.
MEDIA_CAPTURE_ENABLED=false
# Request starts are paced globally within each batch; up to this many downloads
# may overlap. Lower values reduce source/CDN load.
MEDIA_CAPTURE_CONCURRENCY=3
MEDIA_CAPTURE_MINIMUM_DELAY_MS=1500
MEDIA_CAPTURE_AUTO_REQUEST_LIMIT=20

# Set false on development hosts that must never contact source sites.
# Enforcement applies both when queueing and in the in-process worker.
CATALOG_COLLECTION_ENABLED=true
